    "dotenv": "^16.0.1",
    "express": "^4.17.1",
    "express-rate-limit": "^6.4.0",
    "handlebars": "^4.7.6",
    "helmet": "^5.1.0",
    "jwt-simple": "^0.5.6",
    "linkifyjs": "^3.0.5",
    "mongoose": "^6.4.5",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^6.4.6",
    "nodemon": "^2.0.4",
    "socket.io": "^4.5.1",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "concurrently": "^7.2.1",
    "morgan": "^1.9.1"
